#!/usr/bin/env bash
# 実装エージェントのコンテナで使う設定を、ホストから一度だけ取り込む（ホストで実行）。
# ホストの設定が変わっても追従しない（その時点のスナップショット）。取り込み直すときは --force。
#
# 取り込むもの（テストの内容を含まないものだけ）:
#   ~/.claude/CLAUDE.md, ~/.claude/RTK.md   -> $IMPL_CLAUDE_DIR/
#   harness/impl-container/settings.json    -> $IMPL_CLAUDE_DIR/settings.json
#   rtk のバイナリ                           -> $IMPL_TOOLS_DIR/rtk           （/usr/local/bin/rtk に読み取り専用）
#   ~/.config/rtk/*.toml                    -> $IMPL_RTK_CONFIG_DIR/         （/home/dev/.config/rtk に読み取り専用）
#   gopls-lsp プラグイン                     コンテナ内で claude plugin install する
#
# ~/.claude をそのまま見せないこと。テスト作成側のセッション履歴やメモリが入っている。
set -euo pipefail
source "$(dirname "$0")/../config.sh"

force=0
[[ "${1:-}" == "--force" ]] && force=1

if [[ -f "$IMPL_CLAUDE_DIR/settings.json" && $force -eq 0 ]]; then
  echo "取り込み済みです（取り込み直すときは --force）: $IMPL_CLAUDE_DIR" >&2
  exit 0
fi

host_claude="${HOST_CLAUDE_DIR:-$HOME/.claude}"
host_rtk_config="${HOST_RTK_CONFIG_DIR:-$HOME/.config/rtk}"
rtk_bin="$(command -v rtk || true)"
if [[ -z "$rtk_bin" ]]; then
  echo "rtk が見つかりません" >&2
  exit 1
fi

ensure_state_dirs
mkdir -p "$IMPL_TOOLS_DIR" "$IMPL_RTK_CONFIG_DIR"

cp "$host_claude/CLAUDE.md" "$host_claude/RTK.md" "$IMPL_CLAUDE_DIR/"
cp "$HARNESS_DIR/impl-container/settings.json" "$IMPL_CLAUDE_DIR/settings.json"
cp "$(readlink -f "$rtk_bin")" "$IMPL_TOOLS_DIR/rtk"
chmod 755 "$IMPL_TOOLS_DIR/rtk"
for f in config.toml filters.toml; do
  [[ -f "$host_rtk_config/$f" ]] && cp "$host_rtk_config/$f" "$IMPL_RTK_CONFIG_DIR/"
done

echo "gopls-lsp プラグインをコンテナ内にインストールします" >&2
"$HARNESS_DIR/bin/impl-shell" bash -c '
  claude plugin marketplace add anthropics/claude-plugins-official 2>/dev/null \
    || claude plugin marketplace update claude-plugins-official
  claude plugin install gopls-lsp@claude-plugins-official
'

echo "取り込みました: $IMPL_CLAUDE_DIR" >&2
