#!/usr/bin/env bash
# 実装エージェント（Claude Code）を隔離コンテナで起動する（ホストで実行）。
#
# 使い方: impl-shell [--rebuild] [コマンド...]
#   impl-shell                 claude を起動
#   impl-shell claude --resume 前回のセッションを再開
#   impl-shell bash            コンテナ内のシェル
#   --rebuild                  イメージを作り直す（Claude Code の更新もこれで行う）
#
# コンテナに見せるのは次の 3 つだけ:
#   $IMPL_DIR        -> /workspace
#   $IMPL_CLAUDE_DIR -> /home/dev/.claude   （セッション履歴をホストに永続化）
#   $MAILBOX_DIR     -> /mailbox            （hidden-test での受け渡し）
set -euo pipefail
source "$(dirname "$0")/../config.sh"

rebuild=0
if [[ "${1:-}" == "--rebuild" ]]; then rebuild=1; shift; fi

if [[ ! -d "$IMPL_DIR/.git" ]]; then
  echo "実装リポジトリが見つかりません: $IMPL_DIR" >&2
  exit 1
fi

ensure_state_dirs

if [[ $rebuild -eq 1 ]] || ! docker image inspect "$IMPL_IMAGE" > /dev/null 2>&1; then
  build_args=(--build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)")
  [[ $rebuild -eq 1 ]] && build_args+=(--no-cache)
  docker build "${build_args[@]}" -t "$IMPL_IMAGE" "$HARNESS_DIR/impl-container"
fi

"$HARNESS_DIR/bin/watch-mailbox" --daemon

git_name="$(git -C "$IMPL_DIR" config user.name || true)"
git_email="$(git -C "$IMPL_DIR" config user.email || true)"

# 認証トークン: $ENV_FILE の CLAUDE_CODE_OAUTH_TOKEN 行だけを読む（ファイルは source しない）。
# なければ渡さず、コンテナ内で /login した認証情報（$IMPL_CLAUDE_DIR）を使う。
auth_flags=()
if [[ -f "$ENV_FILE" ]]; then
  if [[ "$(stat -c %a "$ENV_FILE")" != "600" ]]; then
    echo "警告: $ENV_FILE の権限が 600 ではありません（chmod 600 を推奨）" >&2
  fi
  token="$(sed -n 's/^[[:space:]]*CLAUDE_CODE_OAUTH_TOKEN[[:space:]]*=[[:space:]]*//p' "$ENV_FILE" | tail -n 1 \
    | sed -e 's/[[:space:]]*$//' -e 's/^["'\'']//' -e 's/["'\'']$//')"
  if [[ -n "$token" ]]; then
    export CLAUDE_CODE_OAUTH_TOKEN="$token"
    # 値はコマンドラインに載せず、名前だけ渡す
    auth_flags+=(-e CLAUDE_CODE_OAUTH_TOKEN)
  fi
  unset token
fi

tty_flags=(-i)
[[ -t 0 && -t 1 ]] && tty_flags+=(-t)

exec docker run --rm "${tty_flags[@]}" \
  --name "abs-gpodder-bridge-impl-$$" \
  --hostname impl \
  -v "$IMPL_DIR:/workspace" \
  -v "$IMPL_CLAUDE_DIR:/home/dev/.claude" \
  -v "$IMPL_CACHE_DIR:/home/dev/.cache" \
  -v "$MAILBOX_DIR:/mailbox" \
  -e GIT_AUTHOR_NAME="$git_name" -e GIT_AUTHOR_EMAIL="$git_email" \
  -e GIT_COMMITTER_NAME="$git_name" -e GIT_COMMITTER_EMAIL="$git_email" \
  "${auth_flags[@]}" \
  "$IMPL_IMAGE" "$@"
