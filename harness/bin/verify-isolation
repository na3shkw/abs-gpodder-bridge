#!/usr/bin/env bash
# 実装エージェントのコンテナから隠蔽テストが見えないことを確かめる（ホストで実行）。
# e2e/CANARY のトークンを、コンテナ内のファイルシステム全体から探す。見つかったら失敗。
set -euo pipefail
source "$(dirname "$0")/../config.sh"

token="$(tr -d '[:space:]' < "$TESTS_REPO/e2e/CANARY")"
if [[ -z "$token" ]]; then
  echo "e2e/CANARY が空です" >&2
  exit 2
fi

echo "コンテナ内を走査しています..." >&2
# 「異常」を表す文字列をそのまま渡すとプロセス一覧に載るので、反転して渡す
reversed="$(rev <<< "$token")"
# grep は読めないファイルがあると一致の有無にかかわらず 2 を返すので、出力で判定する
found="$("$HARNESS_DIR/bin/impl-shell" bash -c '
  t="$(rev <<< "$1")"
  grep -rIl --exclude-dir=proc --exclude-dir=sys --exclude-dir=dev -e "$t" / 2>/dev/null
  exit 0
' _ "$reversed")"
if [[ -n "$found" ]]; then
  echo "$found"
  echo "NG: 上記のファイルから隠蔽テストのカナリアが見えています" >&2
  exit 1
fi
echo "OK: 実装エージェントのコンテナからカナリアは見えません" >&2
