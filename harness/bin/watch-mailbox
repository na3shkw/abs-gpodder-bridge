#!/usr/bin/env bash
# mailbox を監視し、依頼が置かれたら隠蔽テストを実行して結果を置く（ホストで実行）。
#
# 使い方: watch-mailbox            フォアグラウンドで動かす
#         watch-mailbox --daemon   動いていなければバックグラウンドで起動する
#
# プロトコル（$MAILBOX_DIR 配下）:
#   requests/<id>.json    実装者が置く依頼。{"run": "<go test -run のパターン>"}
#   processing/<id>.json  実行中の依頼
#   results/<id>.md       整形済みの結果（人とエージェントが読む用）
#   results/<id>.json     整形済みの結果。これが現れたら完了
#   watcher.heartbeat     watcher が動いている間、定期的に更新される
set -euo pipefail
source "$(dirname "$0")/../config.sh"
ensure_state_dirs

lock="$STATE_DIR/watcher.lock"
log="$STATE_DIR/watcher.log"

if [[ "${1:-}" == "--daemon" ]]; then
  if flock -n "$lock" true; then
    nohup setsid "$0" >> "$log" 2>&1 < /dev/null &
    echo "watcher を起動しました（ログ: $log）" >&2
  fi
  exit 0
fi

exec 9> "$lock"
if ! flock -n 9; then
  echo "watcher はすでに動いています" >&2
  exit 1
fi

echo "$(date -Is) watcher 開始: $MAILBOX_DIR"
shopt -s nullglob
while true; do
  touch "$MAILBOX_DIR/watcher.heartbeat"
  for req in "$MAILBOX_DIR"/requests/*.json; do
    id="$(basename "$req" .json)"
    if [[ ! "$id" =~ ^[A-Za-z0-9_-]{1,80}$ ]]; then
      echo "$(date -Is) 不正な id を破棄: $id"
      rm -f -- "$req"
      continue
    fi
    mv -- "$req" "$MAILBOX_DIR/processing/$id.json"
    run="$(jq -r '.run // "" | strings' "$MAILBOX_DIR/processing/$id.json" 2>/dev/null || true)"
    if [[ ! "$run" =~ ^[A-Za-z0-9_./|^$*+?()-]{0,200}$ ]]; then
      echo "$(date -Is) [$id] 不正な run パターン: 無視して全件実行します"
      run=""
    fi
    echo "$(date -Is) [$id] 実行開始 run=${run:-<all>}"
    # 実行中も heartbeat を更新し続ける
    ( while sleep 10; do touch "$MAILBOX_DIR/watcher.heartbeat"; done ) &
    hb_pid=$!
    if "$HARNESS_DIR/bin/run-hidden-tests" -id "$id" -run "$run" -out "$MAILBOX_DIR/results" > /dev/null; then
      echo "$(date -Is) [$id] 完了"
    else
      echo "$(date -Is) [$id] ハーネスエラー"
      jq -n --arg id "$id" '{id: $id, status: "error", message: "テストハーネスでエラーが発生しました。利用者に確認を依頼してください。"}' \
        > "$MAILBOX_DIR/results/.$id.json.tmp"
      printf '# 隠蔽テスト結果 %s\n\nstatus: **error**\n\nテストハーネスでエラーが発生しました。利用者に確認を依頼してください。\n' "$id" \
        > "$MAILBOX_DIR/results/$id.md"
      mv "$MAILBOX_DIR/results/.$id.json.tmp" "$MAILBOX_DIR/results/$id.json"
    fi
    kill "$hb_pid" 2>/dev/null || true
    rm -f -- "$MAILBOX_DIR/processing/$id.json"
  done
  sleep 2
done
