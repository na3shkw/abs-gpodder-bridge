#!/usr/bin/env bash
# 実装エージェントのコンテナ内で使うクライアント。
# mailbox に依頼を置き、ホスト側の watcher が隠蔽テストを実行して結果を置くのを待つ。
#
# 使い方: hidden-test [-run PATTERN] [-timeout SECONDS]
# 終了コード: 0=全件成功 1=失敗あり 2=ビルド失敗 3=その他のエラー・タイムアウト
set -euo pipefail

MAILBOX="${HIDDEN_TEST_MAILBOX:-/mailbox}"
run=""
timeout=900

while [[ $# -gt 0 ]]; do
  case "$1" in
    -run) run="${2:-}"; shift 2 ;;
    -timeout) timeout="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 3 ;;
  esac
done

if [[ ! -d "$MAILBOX/requests" ]]; then
  echo "mailbox が見つかりません: $MAILBOX" >&2
  exit 3
fi

hb="$MAILBOX/watcher.heartbeat"
if [[ ! -f "$hb" ]] || (( $(date +%s) - $(stat -c %Y "$hb") > 30 )); then
  echo "警告: ホスト側の watcher が動いていないようです。結果が返らない場合は利用者に起動を依頼してください。" >&2
fi

id="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
tmp="$MAILBOX/requests/.$id.tmp"
jq -n --arg run "$run" '{run: $run}' > "$tmp"
mv "$tmp" "$MAILBOX/requests/$id.json"
echo "隠蔽テストを依頼しました (id=$id)。結果を待っています..." >&2

deadline=$(( $(date +%s) + timeout ))
while [[ ! -f "$MAILBOX/results/$id.json" ]]; do
  if (( $(date +%s) > deadline )); then
    echo "タイムアウトしました (${timeout}s)。id=$id" >&2
    exit 3
  fi
  sleep 2
done

cat "$MAILBOX/results/$id.md"
case "$(jq -r .status "$MAILBOX/results/$id.json")" in
  pass) exit 0 ;;
  fail) exit 1 ;;
  build_error) exit 2 ;;
  *) exit 3 ;;
esac
