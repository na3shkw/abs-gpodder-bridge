# compose.yaml で使う設定。このファイルを .env にコピーして書き換える。
# GOPODDER_URL は compose.yaml で決めているので、ここには書かない。
# 各変数の詳しい説明は docs/spec.md の 2.1 節を参照。

# ABS の URL（必須）
ABS_URL=http://abs.example.lan:13378
# ABS の一般ユーザーの API トークン（必須）
ABS_TOKEN=

# ここから下は任意（使うものだけ # を外す）

# ABS の管理者の API トークン。ABS の RSS フィードで購読しているエピソードを対応づけるときだけ使う
# ABS_ADMIN_TOKEN=

# 索引を作る時刻。cron 式（分 時 日 月 曜日）、または @every 15m のような間隔（既定 @every 15m）
# ABS_INDEX_SCHEDULE=@every 15m

# 索引を作る時刻と、ログの時刻に使うタイムゾーン（既定 UTC）
# TZ=Asia/Tokyo

# ABS への 1 リクエストあたりのタイムアウト（秒、既定 5）
# ABS_TIMEOUT_SECONDS=5

# goPodder への 1 リクエストあたりのタイムアウト（秒、既定 30）
# GOPODDER_TIMEOUT_SECONDS=30

# ログの細かさ。debug / info / warn / error のいずれか（既定 info）
# LOG_LEVEL=info

# ブリッジが待ち受けるポート（既定 8080）。変えたときは compose.override.yaml で ports も合わせる
# LISTEN_PORT=8080

# ブリッジのイメージのタグ（既定 latest）
# BRIDGE_IMAGE_TAG=latest

# goPodder のイメージのタグ（既定 v1.4.1。v1.4.0 以上を使うこと）
# GOPODDER_IMAGE_TAG=v1.4.1
