#!/usr/bin/env bash
# e2e/ を 127.0.0.1 で配信し、図の一覧ページ（diagrams/index.html）を見られるようにする。
# 一覧ページからテストのソースへの相対リンク（../post_test.go）をたどれるよう、e2e/ 全体を配信する。
# レビューのチェック状態はブラウザの localStorage に保存されるので、ポートは固定する。
#
# 使い方: serve-diagrams   →  http://127.0.0.1:8766/diagrams/index.html
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"

port="${DIAGRAMS_PORT:-8766}"
echo "http://127.0.0.1:${port}/diagrams/index.html" >&2
exec python3 - "$root/e2e" "$port" <<'PY'
import functools, http.server, sys
root, port = sys.argv[1], int(sys.argv[2])
class Handler(http.server.SimpleHTTPRequestHandler):
    extensions_map = {**http.server.SimpleHTTPRequestHandler.extensions_map,
                      ".go": "text/plain; charset=utf-8", ".svg": "image/svg+xml",
                      ".html": "text/html; charset=utf-8", ".json": "application/json"}
http.server.ThreadingHTTPServer(("127.0.0.1", port), functools.partial(Handler, directory=root)).serve_forever()
PY
